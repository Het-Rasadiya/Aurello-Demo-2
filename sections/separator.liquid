<!-- sections/separator.liquid -->
<style>
  .customstyle{{ section.id }} .separator-wrapper {
    display: flex;
    justify-content: {% if section.settings.line_align == 'left' %}flex-start{% elsif section.settings.line_align == 'right' %}flex-end{% else %}center{% endif %};
    width: 100%;
  }

  .customstyle{{ section.id }} .separator-line {
    border-top: {{ section.settings.line_height }}px {{ section.settings.line_style }} {{ section.settings.line_color }};
    width: {{ section.settings.line_width }}%;
    height: 0;
    margin: 0;
    padding: 0;
    opacity: 1;
  }
</style>

<div class="customstyle{{ section.id }}" data-aos="{{ section.settings.animation }}">
  {%- render 'style-section' -%}
  <div class="{{ section.settings.setwidth }}">
    <div class="separator-wrapper">
      <hr class="separator-line">
    </div>
  </div>
</div>

